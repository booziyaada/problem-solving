/**
 * @param {number} rowIndex
 * @return {number[]}
 */
// https://leetcode.com/problems/pascals-triangle-ii/submissions/2047828318
var getRow = function (rowIndex) {
    if (rowIndex == 0) {
        return [1]
    }
    pre = getRow(rowIndex - 1)
    let row = new Array(rowIndex + 1)
    row[0] = 1
    row[rowIndex] = 1
    for (i = 1; i < rowIndex; i++) {
        row[i] = pre[i] + pre[i - 1]
    }
    return row
};